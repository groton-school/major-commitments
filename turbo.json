{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist"]
    },
    "start": {
      "dependsOn": ["^start"]
    },
    "release": {
      "dependsOn": ["^release"],
      "outputs": ["package.json", "CHANGELOG.md"]
    }
  }
}
